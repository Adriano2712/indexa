# Copie para deploy/.env e preencha (o instalar.sh já gera as senhas). Nunca versione o .env.
DOMINIO=indexa.seudominio.com.br
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_CHAVE=
# true só enquanto os usuários do beta criam conta
PERMITIR_REGISTRO=false

SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Indexa <avisos@seudominio.com.br>

# Recebe e-mail quando um job (coleta, processamento, envio) esgota as tentativas
ALERTAS_EMAIL=

BACKUP_RETENCAO_DIAS=14
# Imagem publicada pelo GitHub Actions; deixe assim para usar a última versão da main
IMAGEM=ghcr.io/adriano2712/indexa:latest
